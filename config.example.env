# Databas — välj ett av alternativen nedan:

# PostgreSQL (rekommenderas — krävs för semantisk sökning med pgvector)
DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABAS>

# SQLite (alternativ — LIKE-sökning, ingen vektorsökning)
# DATABASE_URL=sqlite:///cellar_eu_cache.db

# MCP-transport: stdio (för Claude Desktop) eller http (för HTTP-klienter)
MCP_TRANSPORT=stdio

# HTTP-transport (används endast om MCP_TRANSPORT=http)
MCP_HOST=127.0.0.1
MCP_PORT=8010
MCP_API_KEY=<DIN_API_NYCKEL>

# CELLAR-konfiguration (standardvärden fungerar för offentlig åtkomst)
CELLAR_SPARQL_ENDPOINT=http://publications.europa.eu/webapi/rdf/sparql
# CELEX-resursen i CELLAR. Texten hämtas med innehållsförhandling
# (Accept för format, Accept-Language för språk) mot {CELLAR_REST_BASE}/{CELEX},
# och med den äldre vägen {CELEX}.{SPRÅK}.{format} när det inte räcker.
CELLAR_REST_BASE=http://publications.europa.eu/resource/celex
# Tidsgräns i sekunder för en SPARQL-fråga. Titelsökningar utan träff kan
# ta så lång tid att de slår i gränsen; verktyget säger då hur man avgränsar.
SPARQL_TIMEOUT=60
REST_TIMEOUT=30
# User-Agent mot CELLAR och EUR-Lex. Standardvärdet identifierar projektet
# och versionen. Sätt aldrig en webbläsarlik sträng.
# CELLAR_USER_AGENT=mcp-for-cellar/<VERSION> (+<KONTAKT_URL>)

# Embedding-modell för semantisk sökning
# KBLab:s svenska BERT-modell; laddas ned automatiskt vid första körning (~450 MB)
EMBEDDING_MODEL=KBLab/sentence-bert-swedish-cased

# ── Query-expansion (valfritt) ───────────────────────────────────────────────
# Expanderar söktermer med flerspråkiga juridiska ekvivalenter via LLM.
# Aktiveras med QUERY_EXPANSION_ENABLED=true. Stöder alla OpenAI-kompatibla
# endpoints — Claude, OpenAI, Ollama, LM Studio.
#
# QUERY_EXPANSION_ENABLED=true
# QUERY_EXPANSION_BASE_URL=https://api.anthropic.com/v1   # eller Ollama: http://localhost:11434/v1
# QUERY_EXPANSION_API_KEY=din-api-nyckel
# QUERY_EXPANSION_MODEL=claude-haiku-4-5-20251001          # eller ollama: llama3.2
